    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useMemo } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport {\n  Sparkles,\n  Users,\n  Calendar,\n  UtensilsCrossed,\n  Layers,\n  Flame,\n  CheckCircle,\n  Plus,\n  Minus,\n  Trash2,\n  Phone,\n  Mail,\n  User,\n  MapPin,\n  ClipboardList,\n  ChevronRight,\n  Info,\n  DollarSign,\n  Printer,\n  RotateCcw,\n  BookOpen,\n  ArrowRight,\n  BadgeAlert\n} from \'lucide-react\';\nimport {\n  INDIAN_MENU_ITEMS,\n  INDIAN_EVENT_TYPES,\n  MenuItem,\n  CateringSelection,\n  GuestConfig,\n  calculateQuantity\n} from \'./data\';\n\nexport default function App() {\n  // --- STATE ---\n  const [config, setConfig] = useState<GuestConfig>({\n    count: 120, // default guest count\n    eventType: \'Wedding Reception\',\n    date: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split(\'T\')[0], // 7 days later\n    dietaryPreference: \'all\',\n    contactName: \'\',\n    contactPhone: \'\',\n    contactEmail: \'\',\n    specialNotes: \'\',\n    venueAddress: \'\'\n  });\n\n  const [selectedItems, setSelectedItems] = useState<Record<string, CateringSelection>>({});\n  const [currentTab, setCurrentTab] = useState<\'starters\' | \'juice\' | \'main\' | \'dessert\'>(\'starters\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isSubmitModalOpen, setIsSubmitModalOpen] = useState(false);\n  const [confirmedData, setConfirmedData] = useState<{\n    orderId: string;\n    config: GuestConfig;\n    items: CateringSelection[];\n    totalCost: number;\n    subtotal: number;\n    taxes: number;\n  } | null>(null);\n\n  // --- HANDLERS ---\n  const handleConfigChange = <K extends keyof GuestConfig>(key: K, value: GuestConfig[K]) => {\n    setConfig((prev) => {\n      const updated = { ...prev, [key]: value };\n      // If diet preference changes to Veg Only, de-select any Non-Veg items to prevent system mismatch\n      if (key === \'dietaryPreference\' && value === \'veg-only\') {\n        const cleanedSelected = { ...selectedItems };\n        let countRemoved = 0;\n        Object.keys(cleanedSelected).forEach((id) => {\n          if (cleanedSelected[id].item.type === \'non-veg\') {\n            delete cleanedSelected[id];\n            countRemoved++;\n          }\n        });\n        if (countRemoved > 0) {\n          setSelectedItems(cleanedSelected);\n        }\n      }\n      return updated;\n    });\n  };\n\n  const toggleItemSelection = (item: MenuItem) => {\n    setSelectedItems((prev) => {\n      const copy = { ...prev };\n      if (copy[item.id]) {\n        delete copy[item.id];\n      } else {\n        copy[item.id] = {\n          item,\n          multiplier: 1.0, // default portion scale\n          proportion: 100  // default serve ratio (100% of guests)\n        };\n      }\n      return copy;\n    });\n  };\n\n  const updateItemConfig = (itemId: string, key: \'multiplier\' | \'proportion\', value: number) => {\n    setSelectedItems((prev) => {\n      if (!prev[itemId]) return prev;\n      return {\n        ...prev,\n        [itemId]: {\n          ...prev[itemId],\n          [key]: value\n        }\n      };\n    });\n  };\n\n  const removeSelectedItem = (itemId: string) => {\n    setSelectedItems((prev) => {\n      const copy = { ...prev };\n      delete copy[itemId];\n      return copy;\n    });\n  };\n\n  const resetPlanner = () => {\n    setSelectedItems({});\n    setSearchQuery(\'\');\n    setConfig({\n      count: 120,\n      eventType: \'Wedding Reception\',\n      date: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split(\'T\')[0],\n      dietaryPreference: \'all\',\n      contactName: \'\',\n      contactPhone: \'\',\n      contactEmail: \'\',\n      specialNotes: \'\',\n      venueAddress: \'\'\n    });\n    setConfirmedData(null);\n  };\n\n  // --- FILTERED MENU ITEMS ---\n  const filteredMenuItems = useMemo(() => {\n    return INDIAN_MENU_ITEMS.filter((item) => {\n      if (item.category !== currentTab) return false;\n      if (config.dietaryPreference === \'veg-only\' && item.type === \'non-veg\') return false;\n      if (config.dietaryPreference === \'non-veg-only\' && item.type === \'veg\') return false;\n      if (searchQuery.trim() !== \'\') {\n        return item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n               item.description.toLowerCase().includes(searchQuery.toLowerCase());\n      }\n      return true;\n    });\n  }, [currentTab, config.dietaryPreference, searchQuery]);\n\n  // --- COMPUTATIONS & CALCULATIONS ---\n  const selectedItemsList = useMemo(() => Object.values(selectedItems), [selectedItems]);\n\n  const itemsByCategoryCount = useMemo(() => {\n    const counts = { starters: 0, juice: 0, main: 0, dessert: 0 };\n    selectedItemsList.forEach((sel) => {\n      counts[sel.item.category]++;\n    });\n    return counts;\n  }, [selectedItemsList]);\n\n  // Calculate Subtotal based on: guest_count * pricePerGuest_of_item * portionScaleMultiplier * proportionServed\n  const financials = useMemo(() => {\n    let subtotal = 0;\n    selectedItemsList.forEach((sel) => {\n      const perGuestCost = sel.item.pricePerGuest * sel.multiplier * (sel.proportion / 100);\n      subtotal += perGuestCost * config.count;\n    });\n\n    const taxes = Math.round(subtotal * 0.05); // 5% CGST/SGST professional hospitality levy\n    const totalCost = subtotal + taxes;\n\n    return {\n      subtotal: Math.round(subtotal),\n      taxes,\n      totalCost: Math.round(totalCost),\n      perGuestAverage: selectedItemsList.length > 0 ? Math.round(subtotal / config.count) : 0\n    };\n  }, [selectedItemsList, config.count]);\n\n  // --- HEALTH & ADVISORY SYSTEM ---\n  const advisoryMessages = useMemo(() => {\n    const list: { type: \'info\' | \'warning\' | \'success\'; text: string }[] = [];\n\n    // Starters recommendation\n    const startersCount = itemsByCategoryCount.starters;\n    if (startersCount === 0) {\n      list.push({ type: \'warning\', text: \'Consider picking at least 2 starters to kick off your celebration.\' });\n    } else if (startersCount > 4) {\n      list.push({ type: \'info\', text: \'You have a lavish starter selection. Ensure your kitchen team has adequate fry stations!\' });\n    } else {\n      list.push({ type: \'success\', text: `Excellent: ${startersCount} exquisite starter(s) selected.` });\n    }\n\n    // Refreshers\n    const juicesCount = itemsByCategoryCount.juice;\n    if (juicesCount === 0) {\n      list.push({ type: \'warning\', text: \'Add at least 1 traditional refresher (like Kesar Mango Lassi) for welcoming guests.\' });\n    } else if (juicesCount > 2) {\n      list.push({ type: \'info\', text: \'A wide beverage array creates fantastic variety, consider serving cold welcome rounds.\' });\n    } else {\n      list.push({ type: \'success\', text: \'Beverages are perfectly portioned for guest welcomes.\' });\n    }\n\n    // Main Courses\n    const mainCount = itemsByCategoryCount.main;\n    if (mainCount === 0) {\n      list.push({ type: \'warning\', text: \'Choose your Indian main dishes and handmade breads for a wholesome lunch/dinner.\' });\n    } else if (mainCount < 3) {\n      list.push({ type: \'info\', text: \'A standard Indian main course usually comprises 1 Rice/Biryani, 1 Gravy Curd, and 1 Lentil dish (Dal).\' });\n    } else {\n      list.push({ type: \'success\', text: `${mainCount} Mains are bound to leave guests thoroughly satisfied.` });\n    }\n\n    // Desserts\n    const dessertCount = itemsByCategoryCount.dessert;\n    if (dessertCount === 0) {\n      list.push({ type: \'warning\', text: \'No event is complete without Indian sweets! Select a signature dessert.\' });\n    } else if (dessertCount >= 2) {\n      list.push({ type: \'success\', text: \'A dual royal dessert platter makes for an incredible sweet ending.\' });\n    }\n\n    return list;\n  }, [itemsByCategoryCount]);\n\n  // Handle final submission form\n  const handleBookingSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (selectedItemsList.length === 0) return;\n\n    // Generate standard booking details\n    const orderId = \'ICM-\' + Math.floor(100000 + Math.random() * 900000);\n    setConfirmedData({\n      orderId,\n      config: { ...config },\n      items: [...selectedItemsList],\n      totalCost: financials.totalCost,\n      subtotal: financials.subtotal,\n      taxes: financials.taxes\n    });\n    setIsSubmitModalOpen(false);\n  };\n\n  const foodIcon = (category: string) => {\n    switch (category) {\n      case \'starters\': return \'\360\237\215\242\';\n      case \'juice\': return \'\360\237\245\244\';\n      case \'main\': return \'\360\237\215\233\';\n      case \'dessert\': return \'\360\237\215\250\';\n      default: return \'\360\237\215\275\357\270\217\';\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-neutral-50 text-neutral-800 font-sans selection:bg-amber-100 selection:text-amber-800\">\n      \n      {/* HEADER SECTION */}\n      <header className=\"border-b border-neutral-200 bg-white shadow-xs sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"h-10 w-10 rounded-full bg-linear-to-tr from-amber-500 to-orange-600 flex items-center justify-center text-white shadow-md\">\n              <UtensilsCrossed className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl sm:text-2xl font-display font-bold text-neutral-900 tracking-tight flex items-center gap-2\">\n                Utsav <span className=\"text-amber-600 font-medium text-sm sm:text-base border-l border-neutral-300 pl-2\">Indian Culinary & Event Catering</span>\n              </h1>\n              <p className=\"text-xs text-neutral-500\">Fine traditional dining & custom event menu composer</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 sm:gap-3 w-full md:w-auto justify-end\">\n            <button\n              onClick={resetPlanner}\n              className=\"px-3 py-2 text-xs font-semibold text-neutral-600 hover:text-neutral-900 border border-neutral-200 hover:border-neutral-300 bg-white rounded-lg flex items-center gap-1.5 cursor-pointer transition-all active:scale-[0.98]\"\n              title=\"Reset configuration and selected menu items\"\n            >\n              <RotateCcw className=\"h-3.5 w-3.5\" />\n              Reset\n            </button>\n\n            <div className=\"text-right hidden sm:block\">\n              <span className=\"text-xs text-neutral-400 block uppercase tracking-wider font-semibold\">Live Budget</span>\n              <span className=\"text-lg font-mono font-bold text-amber-700\">\342\202\271{financials.totalCost.toLocaleString(\'en-IN\')}</span>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* RENDER RESERVATION CONFIRMED VIEW */}\n      <AnimatePresence mode=\"wait\">\n        {confirmedData ? (\n          <motion.main\n            key=\"confirmed\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -15 }}\n            className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10\"\n          >\n            <div className=\"bg-white border border-neutral-200 rounded-2xl shadow-xl overflow-hidden\" id=\"booking-invoice\">\n              \n              {/* Confirmed Banner */}\n              <div className=\"bg-linear-to-r from-emerald-600 to-teal-700 p-8 text-center text-white relative\">\n                <div className=\"absolute top-4 right-4 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-mono\">\n                  {confirmedData.orderId}\n                </div>\n                <div className=\"h-16 w-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600 shadow-lg\">\n                  <CheckCircle className=\"h-10 w-10\" />\n                </div>\n                <h2 className=\"text-2xl sm:text-3xl font-display font-extrabold tracking-tight\">Catering Menu Locked!</h2>\n                <p className=\"text-emerald-100 mt-1 max-w-md mx-auto text-sm\">\n                  Your customized Indian banquet plan has been generated and queued for vendor consultation.\n                </p>\n              </div>\n\n              {/* Event Metadata Sheet */}\n              <div className=\"p-6 sm:p-8 border-b border-dashed border-neutral-200 bg-neutral-50/50\">\n                <h3 className=\"font-display font-bold text-neutral-800 text-base mb-4 flex items-center gap-2\">\n                  <ClipboardList className=\"h-4 w-4 text-amber-600\" /> Banquet Details\n                </h3>\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 text-sm\">\n                  <div className=\"bg-white p-3 rounded-xl border border-neutral-100\">\n                    <span className=\"text-xs text-neutral-400 block font-medium\">Guest Counter</span>\n                    <span className=\"font-semibold text-neutral-800 text-lg flex items-center gap-1 mt-0.5 font-mono\">\n                      <Users className=\"h-4 w-4 text-neutral-400\" /> {confirmedData.config.count} Guests\n                    </span>\n                  </div>\n                  <div className=\"bg-white p-3 rounded-xl border border-neutral-100\">\n                    <span className=\"text-xs text-neutral-400 block font-medium\">Occasion Type</span>\n                    <span className=\"font-semibold text-neutral-800 text-sm block truncate mt-1\">\n                      {confirmedData.config.eventType}\n                    </span>\n                  </div>\n                  <div className=\"bg-white p-3 rounded-xl border border-neutral-100\">\n                    <span className=\"text-xs text-neutral-400 block font-medium\">Event Date</span>\n                    <span className=\"font-semibold text-neutral-800 text-sm flex items-center gap-1 mt-1 font-mono\">\n                      <Calendar className=\"h-3.5 w-3.5 text-neutral-400\" /> {confirmedData.config.date}\n                    </span>\n                  </div>\n                  <div className=\"bg-white p-3 rounded-xl border border-neutral-100\">\n                    <span className=\"text-xs text-neutral-400 block font-medium\">Dietary Standard</span>\n                    <span className=\"font-semibold text-neutral-800 text-sm mt-1 flex items-center gap-1.5 capitalize\">\n                      <span className={`h-2.5 w-2.5 rounded-full ${\n                        confirmedData.config.dietaryPreference === \'veg-only\' ? \'bg-green-600\' :\n                        confirmedData.config.dietaryPreference === \'non-veg-only\' ? \'bg-red-600\' : \'bg-amber-500\'\n                      }`} />\n                      {confirmedData.config.dietaryPreference === \'all\' ? \'Universal\' : confirmedData.config.dietaryPreference.replace(\'-\', \' \')}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm pt-4 border-t border-neutral-100\">\n                  <div>\n                    <span className=\"text-xs text-neutral-400 font-semibold block\">HOST CONTACT</span>\n                    <p className=\"font-semibold text-neutral-800 mt-0.5\">{confirmedData.config.contactName || \'Valued Guest\'}</p>\n                    <p className=\"text-xs text-neutral-500 flex items-center gap-1 mt-0.5 font-mono\">\n                      <Phone className=\"h-3 w-3\" /> {confirmedData.config.contactPhone || \'Not Configured\'}\n                    </p>\n                    <p className=\"text-xs text-neutral-500 flex items-center gap-1 font-mono\">\n                      <Mail className=\"h-3 w-3\" /> {confirmedData.config.contactEmail || \'Not Configured\'}\n                    </p>\n                  </div>\n                  <div>\n                    <span className=\"text-xs text-neutral-400 font-semibold block\">VENUE PLACE</span>\n                    <p className=\"text-xs text-neutral-600 mt-1 flex items-start gap-1\">\n                      <MapPin className=\"h-3.5 w-3.5 text-neutral-400 shrink-0 mt-0.5\" />\n                      <span>{confirmedData.config.venueAddress || \'To Be Confirmed / Venue Services Outlined\'}</span>\n                    </p>\n                    {confirmedData.config.specialNotes && (\n                      <div className=\"mt-2 text-xs bg-amber-50 text-amber-800 p-2 rounded border border-amber-100\">\n                        <strong className=\"block\">Host Directives:</strong>\n                        {confirmedData.config.specialNotes}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n\n              {/* Items Breakdown Sheet */}\n              <div className=\"p-6 sm:p-8\">\n                <h3 className=\"font-display font-bold text-neutral-800 text-base mb-4 flex items-center gap-2\">\n                  <BookOpen className=\"h-4 w-4 text-amber-600\" /> Selected Cuisine Layout\n                </h3>\n                \n                <div className=\"space-y-4\">\n                  {[\'starters\', \'juice\', \'main\', \'dessert\'].map((cat) => {\n                    const groupItems = confirmedData.items.filter((s) => s.item.category === cat);\n                    if (groupItems.length === 0) return null;\n\n                    return (\n                      <div key={cat} className=\"border border-neutral-100 rounded-xl p-4 bg-neutral-50/20\">\n                        <h4 className=\"text-xs font-bold uppercase tracking-wider text-amber-600 mb-2 flex items-center gap-1.5\">\n                          <span>{foodIcon(cat)}</span>\n                          {cat === \'main\' ? \'Main Course\' : cat === \'juice\' ? \'Beverage Refreshers\' : cat}\n                        </h4>\n                        \n                        <div className=\"divide-y divide-neutral-100\">\n                          {groupItems.map((selected) => {\n                            const quantityEstimate = calculateQuantity(\n                              confirmedData.config.count,\n                              selected.item,\n                              selected.multiplier,\n                              selected.proportion\n                            );\n                            return (\n                              <div key={selected.item.id} className=\"py-2.5 flex items-center justify-between gap-4 text-sm\">\n                                <div className=\"min-w-0\">\n                                  <div className=\"flex items-center gap-1.5\">\n                                    <span className={`inline-block h-2.5 w-2.5 rounded-full ${selected.item.type === \'veg\' ? \'bg-green-600\' : \'bg-red-600\'}`} title={selected.item.type} />\n                                    <span className=\"font-semibold text-neutral-800\">{selected.item.name}</span>\n                                  </div>\n                                  <p className=\"text-xs text-neutral-400 mt-0.5 truncate max-w-sm sm:max-w-md md:max-w-lg\">\n                                    {selected.item.description}\n                                  </p>\n                                </div>\n                                <div className=\"text-right shrink-0\">\n                                  <span className=\"font-mono font-bold text-neutral-800 block text-sm\">\n                                    {quantityEstimate} {selected.item.unit}\n                                  </span>\n                                  <span className=\"text-xs text-neutral-400\">\n                                    {selected.multiplier !== 1 ? `${selected.multiplier}x custom ratio \342\200\242 ` : \'\'} \n                                    {selected.proportion}% of guests\n                                  </span>\n                                </div>\n                              </div>\n                            );\n                          })}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                {/* Final Quote Box */}\n                <div className=\"mt-8 border-t border-neutral-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-6\">\n                  <div>\n                    <span className=\"text-xs text-neutral-400 uppercase tracking-widest font-semibold block\">Hospitality Pricing Summary</span>\n                    <div className=\"flex items-baseline gap-2 mt-1\">\n                      <span className=\"text-2xl font-mono font-extrabold text-neutral-900\">\342\202\271{confirmedData.totalCost.toLocaleString(\'en-IN\')}</span>\n                      <span className=\"text-xs text-neutral-500 font-semibold\">(Average \342\202\271{Math.round(confirmedData.subtotal / confirmedData.config.count)} / plate)</span>\n                    </div>\n                    <p className=\"text-xs text-neutral-400 mt-0.5\">Includes baseline preparation, fresh garnish, standard linen and chaffing sets.</p>\n                  </div>\n\n                  <div className=\"flex gap-3 w-full sm:w-auto shrink-0\">\n                    <button\n                      onClick={() => window.print()}\n                      className=\"flex-1 sm:flex-none px-4 py-2.5 text-sm font-semibold text-neutral-700 bg-neutral-100 hover:bg-neutral-200 rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 active:scale-[0.98]\"\n                    >\n                      <Printer className=\"h-4 w-4\" /> Print Quotation\n                    </button>\n                    <button\n                      onClick={resetPlanner}\n                      className=\"flex-1 sm:flex-none px-5 py-2.5 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 shadow-md rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 active:scale-[0.98]\"\n                    >\n                      Plan Another Event <ArrowRight className=\"h-4 w-4\" />\n                    </button>\n                  </div>\n                </div>\n\n              </div>\n\n            </div>\n          </motion.main>\n        ) : (\n          <motion.main\n            key=\"configurer\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\"\n          >\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n              \n              {/* LEFT & CENTER PANEL: CONTROLS & CUISINE CARDS */}\n              <div className=\"lg:col-span-8 space-y-6\">\n                \n                {/* 1. MASTER BANQUET PRESETS & CONFIGURATION PANEL */}\n                <div className=\"bg-white border border-neutral-200 rounded-2xl p-5 shadow-xs\">\n                  <h3 className=\"text-xs font-bold uppercase tracking-widest text-orange-600 mb-4 flex items-center gap-1.5\">\n                    <Sparkles className=\"h-3.5 w-3.5\" /> 1. Define Event Scope & Hospitality Settings\n                  </h3>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4\">\n                    \n                    {/* Occasion Dropdown */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"text-xs font-extrabold text-neutral-700 uppercase block tracking-wide\">Event Occasion</label>\n                      <div className=\"relative\">\n                        <select\n                          value={config.eventType}\n                          onChange={(e) => handleConfigChange(\'eventType\', e.target.value)}\n                          className=\"w-full text-sm rounded-xl border border-neutral-200 py-2 pl-3 pr-8 bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-neutral-800 font-medium cursor-pointer\"\n                        >\n                          {INDIAN_EVENT_TYPES.map((type) => (\n                            <option key={type} value={type}>{type}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </div>\n\n                    {/* Guest Count Slider & Value */}\n                    <div className=\"space-y-1.5 sm:col-span-2\">\n                      <div className=\"flex justify-between items-center\">\n                        <label className=\"text-xs font-extrabold text-neutral-700 uppercase tracking-wide\">Guest Attendance</label>\n                        <div className=\"flex items-center gap-1 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-lg text-amber-800 font-mono text-xs font-extrabold\">\n                          <Users className=\"h-3 w-3\" />\n                          <span>{config.count} pax</span>\n                        </div>\n                      </div>\n                      \n                      <div className=\"flex items-center gap-3 py-1\">\n                        <button\n                          type=\"button\"\n                          onClick={() => handleConfigChange(\'count\', Math.max(10, config.count - 10))}\n                          className=\"h-8 w-8 rounded-full border border-neutral-200 bg-white shadow-xs flex items-center justify-center text-neutral-600 hover:text-neutral-900 hover:border-neutral-300 cursor-pointer active:scale-95 shrink-0\"\n                          title=\"Reduce guests by 10\"\n                        >\n                          <Minus className=\"h-3.5 w-3.5\" />\n                        </button>\n                        \n                        <input\n                          type=\"range\"\n                          min=\"10\"\n                          max=\"1000\"\n                          step=\"10\"\n                          value={config.count}\n                          onChange={(e) => handleConfigChange(\'count\', parseInt(e.target.value))}\n                          className=\"w-full accent-amber-600 cursor-ew-resize py-2 h-1 bg-neutral-200 rounded-lg appearance-none\"\n                        />\n\n                        <button\n                          type=\"button\"\n                          onClick={() => handleConfigChange(\'count\', Math.min(1000, config.count + 10))}\n                          className=\"h-8 w-8 rounded-full border border-neutral-200 bg-white shadow-xs flex items-center justify-center text-neutral-600 hover:text-neutral-900 hover:border-neutral-300 cursor-pointer active:scale-95 shrink-0\"\n                          title=\"Increase guests by 10\"\n                        >\n                          <Plus className=\"h-3.5 w-3.5\" />\n                        </button>\n                      </div>\n                    </div>\n\n                    {/* Event Calendar Date */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"text-xs font-extrabold text-neutral-700 uppercase block tracking-wide\">Launch Date</label>\n                      <input\n                        type=\"date\"\n                        value={config.date}\n                        min={new Date().toISOString().split(\'T\')[0]}\n                        onChange={(e) => handleConfigChange(\'date\', e.target.value)}\n                        className=\"w-full text-sm rounded-xl border border-neutral-200 p-2 bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500 text-neutral-800 font-mono font-medium cursor-pointer\"\n                      />\n                    </div>\n\n                  </div>\n\n                  {/* Dietary Preferences and Filters Row */}\n                  <div className=\"mt-5 pt-4 border-t border-neutral-100 flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                    <div className=\"space-y-1.5\">\n                      <span className=\"text-xs font-extrabold text-neutral-700 uppercase tracking-wide block\">Banquet Dining Standard</span>\n                      <div className=\"flex flex-wrap gap-2\">\n                        {[\n                          { key: \'all\', title: \'Universal Diet (All Items)\', color: \'bg-amber-500\' },\n                          { key: \'veg-only\', title: \'\360\237\214\277 Pure Vegetarian\', color: \'bg-green-600\' },\n                          { key: \'non-veg-only\', title: \'\360\237\215\227 Non-Vegetarian Heavy\', color: \'bg-red-600\' }\n                        ].map((opt) => {\n                          const isActive = config.dietaryPreference === opt.key;\n                          return (\n                            <button\n                              key={opt.key}\n                              type=\"button\"\n                              onClick={() => handleConfigChange(\'dietaryPreference\', opt.key as any)}\n                              className={`px-3.5 py-1.5 text-xs font-semibold rounded-full border transition-all cursor-pointer flex items-center gap-1.5 ${\n                                isActive\n                                  ? \'bg-neutral-900 text-white border-neutral-900 shadow-sm\'\n                                  : \'bg-white text-neutral-600 border-neutral-200 hover:border-neutral-300 active:scale-95\'\n                              }`}\n                            >\n                              <span className={`h-2 w-2 rounded-full ${opt.color}`} />\n                              {opt.title}\n                            </button>\n                          );\n                        })}\n                      </div>\n                    </div>\n\n                    <div className=\"relative md:max-w-xs w-full\">\n                      <input\n                        type=\"search\"\n                        placeholder=\"Search Paneer, Tikka, Biryani...\"\n                        value={searchQuery}\n                        onChange={(e) => setSearchQuery(e.target.value)}\n                        className=\"w-full text-xs rounded-xl border border-neutral-200 pl-3 pr-8 py-2.5 bg-neutral-50/50 hover:bg-neutral-50 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500 text-neutral-800\"\n                      />\n                      <span className=\"absolute right-3 top-3 text-neutral-400 text-xs font-semibold\">\360\237\224\215</span>\n                    </div>\n                  </div>\n\n                </div>\n\n                {/* 2. CATEGORIES NAVIGATION TABS */}\n                <div className=\"bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-xs\">\n                  <div className=\"flex border-b border-neutral-200 overflow-x-auto no-scrollbar\">\n                    {[\n                      { key: \'starters\', title: \'Starters & Hors\', subtitle: \'Pakoras & Tikkas\', icon: \'\360\237\215\242\' },\n                      { key: \'juice\', title: \'Juice & Welcome\', subtitle: \'Lassi & Mocktails\', icon: \'\360\237\245\244\' },\n                      { key: \'main\', title: \'Main Courses\', subtitle: \'Curries, Breads & Rice\', icon: \'\360\237\215\233\' },\n                      { key: \'dessert\', title: \'Royal Halwa & Cream\', subtitle: \'Desserts & Sweets\', icon: \'\360\237\215\250\' }\n                    ].map((cat) => {\n                      const isActive = currentTab === cat.key;\n                      const countSelected = itemsByCategoryCount[cat.key as \'starters\' | \'juice\' | \'main\' | \'dessert\'];\n                      return (\n                        <button\n                          key={cat.key}\n                          onClick={() => {\n                            setCurrentTab(cat.key as any);\n                            setSearchQuery(\'\');\n                          }}\n                          className={`flex-1 min-w-40 p-4 text-left transition-all relative border-r last:border-0 border-neutral-100 shrink-0 cursor-pointer ${\n                            isActive ? \'bg-amber-50/40 text-amber-950\' : \'bg-white hover:bg-neutral-50/50\'\n                          }`}\n                        >\n                          <div className=\"flex justify-between items-start\">\n                            <span className=\"text-2xl\">{cat.icon}</span>\n                            {countSelected > 0 && (\n                              <span className=\"inline-flex h-5 min-w-5 px-1.5 items-center justify-center rounded-full bg-amber-600 text-[10px] font-mono font-bold text-white shadow-xs\">\n                                {countSelected}\n                              </span>\n                            )}\n                          </div>\n                          \n                          <div className=\"mt-3\">\n                            <h4 className=\"text-xs font-bold uppercase tracking-wider block\">{cat.title}</h4>\n                            <p className=\"text-[10px] text-neutral-400 mt-0.5 font-medium\">{cat.subtitle}</p>\n                          </div>\n\n                          {isActive && (\n                            <motion.div\n                              layoutId=\"active-tab-indicator\"\n                              className=\"absolute bottom-0 left-0 right-0 h-1 bg-amber-600\"\n                            />\n                          )}\n                        </button>\n                      );\n                    })}\n                  </div>\n\n                  {/* CUISINE GRID */}\n                  <div className=\"p-6\">\n                    {filteredMenuItems.length === 0 ? (\n                      <div className=\"text-center py-12\">\n                        <span className=\"text-4xl block mb-2\">\360\237\215\275\357\270\217</span>\n                        <h4 className=\"text-sm font-semibold text-neutral-600\">No traditional dishes found</h4>\n                        <p className=\"text-xs text-neutral-400 mt-1\">Try relaxing filters or adjusting your query string.</p>\n                      </div>\n                    ) : (\n                      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                        {filteredMenuItems.map((item) => {\n                          const isSelected = !!selectedItems[item.id];\n                          const selectedAttr = selectedItems[item.id];\n\n                          return (\n                            <motion.div\n                              layout\n                              key={item.id}\n                              className={`border rounded-2xl overflow-hidden transition-all flex flex-col justify-between ${\n                                isSelected\n                                  ? \'border-amber-500 bg-amber-500/[0.01] shadow-md shadow-amber-500/5\'\n                                  : \'border-neutral-200 hover:border-neutral-300 bg-white hover:shadow-xs\'\n                              }`}\n                            >\n                              <div className=\"p-5\">\n                                {/* Badge Area */}\n                                <div className=\"flex justify-between items-center gap-2 mb-2.5\">\n                                  <div className=\"flex items-center gap-1.5\">\n                                    <span\n                                      className={`h-2.5 w-2.5 rounded-full ring-2 ring-white shadow-xs ${\n                                        item.type === \'veg\' ? \'bg-green-600\' : \'bg-red-600\'\n                                      }`}\n                                      title={item.type === \'veg\' ? \'Pure Vegetarian (\360\237\214\277)\' : \'Non-Vegetarian (\360\237\215\227)\'}\n                                    />\n                                    <span className=\"text-[10px] font-extrabold uppercase tracking-widest text-neutral-400\">\n                                      {item.type === \'veg\' ? \'Veg\' : \'Non-Veg\'}\n                                    </span>\n                                  </div>\n\n                                  <div className=\"flex items-center gap-1\">\n                                    {/* Spice level representation */}\n                                    {item.spicyLevel > 0 ? (\n                                      Array.from({ length: item.spicyLevel }).map((_, i) => (\n                                        <Flame key={i} className=\"h-3 w-3 text-red-500 fill-red-500\" />\n                                      ))\n                                    ) : (\n                                      <span className=\"text-[9px] font-extrabold px-1.5 py-0.5 rounded-full bg-sky-50 text-sky-800 tracking-wider\">MILD SENS</span>\n                                    )}\n\n                                    {item.popular && (\n                                      <span className=\"text-[9px] font-extrabold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full uppercase tracking-wider ml-1.5 flex items-center gap-0.5\">\n                                        \342\255\220 Popular\n                                      </span>\n                                    )}\n                                  </div>\n                                </div>\n\n                                {/* Title & Price */}\n                                <div className=\"flex items-start justify-between gap-2\">\n                                  <h4 className=\"font-display font-bold text-neutral-800 text-sm\">{item.name}</h4>\n                                  <div className=\"text-right\">\n                                    <span className=\"font-mono font-bold text-amber-800 text-sm\">\342\202\271{item.pricePerGuest}</span>\n                                    <span className=\"text-[9px] text-neutral-400 block font-medium\">/ guest plate</span>\n                                  </div>\n                                </div>\n\n                                {/* Description */}\n                                <p className=\"text-xs text-neutral-500 mt-2 leading-relaxed font-normal\">\n                                  {item.description}\n                                </p>\n                              </div>\n\n                              {/* Action Footer of the item card */}\n                              <div className=\"px-5 pb-4 pt-3 mt-auto border-t border-neutral-100 bg-neutral-50/40 flex flex-col gap-3\">\n                                <div className=\"flex justify-between items-center\">\n                                  <span className=\"text-[10px] text-neutral-400 font-medium\">\n                                    Recommended: <span className=\"font-mono uppercase font-bold text-neutral-500\">~{(item.factorPerGuest * config.count).toFixed(0)} {item.unit}</span>\n                                  </span>\n\n                                  <button\n                                    onClick={() => toggleItemSelection(item)}\n                                    className={`px-4 py-1.5 text-xs font-bold rounded-xl transition-all cursor-pointer shadow-xs ${\n                                      isSelected\n                                        ? \'bg-amber-600 hover:bg-amber-700 text-white\'\n                                        : \'bg-white border border-neutral-200 text-neutral-700 hover:bg-neutral-50 hover:border-neutral-300\'\n                                    }`}\n                                  >\n                                    {isSelected ? \'\342\234\223 Added\' : \'+ Add Item\'}\n                                  </button>\n                                </div>\n\n                                {/* IF SELECTED, SHOW INTERACTIVE INDIVIDUAL QUANTITY ADVANCED CONTROLS */}\n                                <AnimatePresence>\n                                  {isSelected && selectedAttr && (\n                                    <motion.div\n                                      initial={{ opacity: 0, height: 0 }}\n                                      animate={{ opacity: 1, height: \'auto\' }}\n                                      exit={{ opacity: 0, height: 0 }}\n                                      className=\"space-y-3 pt-2.5 overflow-hidden\"\n                                    >\n                                      \n                                      {/* Modifier 1: Portion Scale */}\n                                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pb-1\">\n                                        <div className=\"space-y-1\">\n                                          <label className=\"text-[9px] font-extrabold uppercase text-neutral-500 block tracking-wide\">\n                                            Portion Size Scale\n                                          </label>\n                                          \n                                          <div className=\"flex rounded-lg border border-neutral-200 overflow-hidden bg-white\">\n                                            {[\n                                              { label: \'Light\', val: 0.8 },\n                                              { label: \'Std\', val: 1.0 },\n                                              { label: \'Heavy\', val: 1.3 }\n                                            ].map((opt) => (\n                                              <button\n                                                key={opt.val}\n                                                type=\"button\"\n                                                onClick={() => updateItemConfig(item.id, \'multiplier\', opt.val)}\n                                                className={`flex-1 text-[9px] py-1 font-bold border-r last:border-0 border-neutral-100 cursor-pointer ${\n                                                  selectedAttr.multiplier === opt.val\n                                                    ? \'bg-neutral-800 text-white\'\n                                                    : \'bg-white text-neutral-600 hover:bg-neutral-50\'\n                                                }`}\n                                              >\n                                                {opt.label} ({opt.val}x)\n                                              </button>\n                                            ))}\n                                          </div>\n                                        </div>\n\n                                        {/* Modifier 2: Serve Proportion ratio (e.g. serve 100% guests or less) */}\n                                        <div className=\"space-y-1\">\n                                          <div className=\"flex justify-between items-center\">\n                                            <label className=\"text-[9px] font-extrabold uppercase text-neutral-500 tracking-wide\">\n                                              Dining Crowd Coverage\n                                            </label>\n                                            <span className=\"text-[8px] font-mono text-neutral-400 font-bold\">\n                                              {selectedAttr.proportion}% of guests\n                                            </span>\n                                          </div>\n                                          \n                                          <div className=\"flex rounded-lg border border-neutral-200 overflow-hidden bg-white\">\n                                            {[100, 75, 50, 25].map((pct) => (\n                                              <button\n                                                key={pct}\n                                                type=\"button\"\n                                                onClick={() => updateItemConfig(item.id, \'proportion\', pct)}\n                                                className={`flex-1 text-[9px] py-1 font-bold border-r last:border-0 border-neutral-100 cursor-pointer ${\n                                                  selectedAttr.proportion === pct\n                                                    ? \'bg-neutral-800 text-white\'\n                                                    : \'bg-white text-neutral-600 hover:bg-neutral-50\'\n                                                }`}\n                                              >\n                                                {pct}%\n                                              </button>\n                                            ))}\n                                          </div>\n                                        </div>\n                                      </div>\n\n                                      {/* Total calculation badge */}\n                                      <div className=\"bg-amber-50/80 border border-amber-200/50 p-2 rounded-xl flex items-center justify-between text-[11px] text-amber-900\">\n                                        <span className=\"font-semibold text-neutral-500\">Live Portions:</span>\n                                        <div className=\"flex items-center gap-1.5 font-bold\">\n                                          <span className=\"font-mono text-amber-800\">\n                                            {calculateQuantity(\n                                              config.count,\n                                              item,\n                                              selectedAttr.multiplier,\n                                              selectedAttr.proportion\n                                            )}{\' \'}\n                                            {item.unit}\n                                          </div>\n                                        </div>\n                                      </div>\n                                    </motion.div>\n                                  )}\n                                </AnimatePresence>\n\n                              </div>\n                            </motion.div>\n                          );\n                        })}\n                      </div>\n                    )}\n                  </div>\n                </div>\n\n              </div>\n\n              {/* RIGHT SIDE PANEL: LIVE ESTIMATE SIDEBAR */}\n              <div className=\"lg:col-span-4 space-y-6\">\n                \n                <div className=\"bg-white border border-neutral-200 rounded-3xl p-6 shadow-md sticky top-24\">\n                  <h3 className=\"font-display font-extrabold text-neutral-950 text-base mb-4 flex items-center gap-2 border-b border-neutral-100 pb-3\">\n                    <Layers className=\"h-5 w-5 text-amber-600\" /> Selected Event Banquet\n                  </h3>\n\n                  {/* Empty state selection alert */}\n                  {selectedItemsList.length === 0 ? (\n                    <div className=\"text-center py-10 px-4\">\n                      <div className=\"h-10 w-10 bg-neutral-100 rounded-full flex items-center justify-center mx-auto mb-3 text-neutral-400\">\n                        <UtensilsCrossed className=\"h-5 w-5\" />\n                      </div>\n                      <h4 className=\"text-sm font-semibold text-neutral-600\">No items on plate</h4>\n                      <p className=\"text-xs text-neutral-400 mt-1\">\n                        Select traditional appetizers, main courses, mocktails, and desserts above to see live pricing details.\n                      </p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-6\">\n                      \n                      {/* Interactive Selection List grouped by category */}\n                      <div className=\"max-h-60 overflow-y-auto pr-1 space-y-3\">\n                        {selectedItemsList.map((selected) => {\n                          const quantity = calculateQuantity(\n                            config.count,\n                            selected.item,\n                            selected.multiplier,\n                            selected.proportion\n                          );\n                          return (\n                            <div key={selected.item.id} className=\"flex justify-between items-start gap-2 bg-neutral-50 hover:bg-neutral-100/70 p-2.5 rounded-xl border border-neutral-100 transition-all text-xs\">\n                              <div className=\"min-w-0\">\n                                <div className=\"flex items-center gap-1\">\n                                  <span className={`inline-block h-2 w-2 rounded-full shrink-0 ${selected.item.type === \'veg\' ? \'bg-green-600\' : \'bg-red-600\'}`} />\n                                  <h4 className=\"font-bold text-neutral-800 truncate\">{selected.item.name}</h4>\n                                </div>\n                                <div className=\"text-[10px] text-neutral-400 font-semibold mt-0.5\">\n                                  {quantity} {selected.item.unit} ({selected.multiplier}x multip)\n                                </div>\n                              </div>\n\n                              <div className=\"flex items-center gap-2 shrink-0\">\n                                <span className=\"font-mono font-bold text-neutral-800\">\n                                  \342\202\271{Math.round(selected.item.pricePerGuest * selected.multiplier * (selected.proportion / 100) * config.count).toLocaleString(\'en-IN\')}\n                                </span>\n                                <button\n                                  type=\"button\"\n                                  onClick={() => removeSelectedItem(selected.item.id)}\n                                  className=\"text-neutral-400 hover:text-red-500 cursor-pointer active:scale-90\"\n                                >\n                                  <Trash2 className=\"h-3.5 w-3.5\" />\n                                </button>\n                              </div>\n                            </div>\n                          );\n                        })}\n                      </div>\n\n                      {/* TAXES, ADVISORY & SMART ESTIMATES */}\n                      <div className=\"bg-amber-50/40 rounded-2xl p-4 border border-amber-500/10 space-y-3\">\n                        <h4 className=\"text-[10px] font-extrabold uppercase tracking-widest text-amber-800 flex items-center gap-1\">\n                          <Info className=\"h-3.5 w-3.5\" /> Smart Catering Coordinator\n                        </h4>\n                        \n                        <div className=\"space-y-2 max-h-36 overflow-y-auto divide-y divide-amber-800/10\">\n                          {advisoryMessages.map((adv, idx) => (\n                            <div key={idx} className=\"flex items-start gap-1.5 text-xs py-1.5 first:pt-0\">\n                              <span className=\"mt-0.5\">\n                                {adv.type === \'success\' ? \'\360\237\237\242\' : adv.type === \'warning\' ? \'\342\232\240\357\270\217\' : \'\360\237\222\241\'}\n                              </span>\n                              <p className=\"text-[11px] leading-relaxed text-amber-950 font-normal\">\n                                {adv.text}\n                              </p>\n                            </div>\n                          ))}\n                        </div>\n                      </div>\n\n                      {/* Pricing Summary */}\n                      <div className=\"border-t border-neutral-100 pt-4 space-y-2 text-xs\">\n                        <div className=\"flex justify-between font-medium text-neutral-500\">\n                          <span>Ingredients & Catering Base:</span>\n                          <span className=\"font-mono\">\342\202\271{financials.subtotal.toLocaleString(\'en-IN\')}</span>\n                        </div>\n                        <div className=\"flex justify-between font-medium text-neutral-500\">\n                          <span>CGST / SGST Tax (5%):</span>\n                          <span className=\"font-mono\">\342\202\271{financials.taxes.toLocaleString(\'en-IN\')}</span>\n                        </div>\n                        <div className=\"flex justify-between text-neutral-800 pt-2 border-t border-neutral-100\">\n                          <div>\n                            <span className=\"font-bold text-sm block\">Total Estimated Quote:</span>\n                            <span className=\"text-[9px] text-neutral-400 font-semibold block\">Based on {config.count} attendees</span>\n                          </div>\n                          <div className=\"text-right\">\n                            <span className=\"font-mono font-extrabold text-lg text-amber-700\">\342\202\271{financials.totalCost.toLocaleString(\'en-IN\')}</span>\n                            <span className=\"text-[10px] text-neutral-400 block font-bold\">Plate Avg: \342\202\271{financials.perGuestAverage}</span>\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* Submit action button */}\n                      <button\n                        type=\"button\"\n                        onClick={() => setIsSubmitModalOpen(true)}\n                        className=\"w-full text-center py-3 bg-linear-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 text-white font-extrabold text-sm rounded-xl transition-all cursor-pointer shadow-lg shadow-amber-600/10 active:scale-[0.98]\"\n                      >\n                        Proceed to Final Review & Lock Menu\n                      </button>\n\n                    </div>\n                  )}\n                </div>\n\n              </div>\n\n            </div>\n          </motion.main>\n        )}\n      </AnimatePresence>\n\n      {/* FINAL SUBMIT DIALOG overlay */}\n      {isSubmitModalOpen && (\n        <div className=\"fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            exit={{ opacity: 0, scale: 0.95 }}\n            className=\"bg-white rounded-3xl max-w-lg w-full border border-neutral-100 overflow-hidden shadow-2xl\"\n          >\n            {/* Header */}\n            <div className=\"bg-linear-to-r from-neutral-900 to-neutral-800 p-6 text-white text-center\">\n              <h3 className=\"font-display font-extrabold text-lg tracking-tight\">Lock Banquet Booking Info</h3>\n              <p className=\"text-xs text-neutral-400 mt-1\">Please supply booking parameters below so our executive culinary advisor can coordinate with the venue.</p>\n            </div>\n\n            {/* Form */}\n            <form onSubmit={handleBookingSubmit} className=\"p-6 space-y-4\">\n              \n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div className=\"space-y-1\">\n                  <label className=\"text-[10px] font-extrabold uppercase text-neutral-600 block\">Host Name</label>\n                  <div className=\"relative\">\n                    <User className=\"absolute left-3 top-2.5 h-3.5 w-3.5 text-neutral-400\" />\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g. Ramesh Sharma\"\n                      value={config.contactName}\n                      onChange={(e) => handleConfigChange(\'contactName\', e.target.value)}\n                      className=\"w-full text-xs rounded-xl border border-neutral-200 pl-9 pr-3 py-2 focus:outline-hidden focus:ring-2 focus:ring-amber-500\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"space-y-1\">\n                  <label className=\"text-[10px] font-extrabold uppercase text-neutral-600 block\">Contact Phone</label>\n                  <div className=\"relative\">\n                    <Phone className=\"absolute left-3 top-2.5 h-3.5 w-3.5 text-neutral-400\" />\n                    <input\n                      type=\"tel\"\n                      required\n                      placeholder=\"e.g. +91 98765 43210\"\n                      value={config.contactPhone}\n                      onChange={(e) => handleConfigChange(\'contactPhone\', e.target.value)}\n                      className=\"w-full text-xs rounded-xl border border-neutral-200 pl-9 pr-3 py-2 focus:outline-hidden focus:ring-2 focus:ring-amber-500\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"text-[10px] font-extrabold uppercase text-neutral-600 block\">Contact Email</label>\n                <div className=\"relative\">\n                  <Mail className=\"absolute left-3 top-2.5 h-3.5 w-3.5 text-neutral-400\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"ramesh@example.com\"\n                    value={config.contactEmail}\n                    onChange={(e) => handleConfigChange(\'contactEmail\', e.target.value)}\n                    className=\"w-full text-xs rounded-xl border border-neutral-200 pl-9 pr-3 py-2 focus:outline-hidden focus:ring-2 focus:ring-amber-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"text-[10px] font-extrabold uppercase text-neutral-600 block\">Venue/Delivery Address</label>\n                <div className=\"relative\">\n                  <MapPin className=\"absolute left-3 top-2.5 h-3.5 w-3.5 text-neutral-400\" />\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. Imperial Gardens Banquet Hall, Sector-4, Gurgaon\"\n                    value={config.venueAddress}\n                    onChange={(e) => handleConfigChange(\'venueAddress\', e.target.value)}\n                    className=\"w-full text-xs rounded-xl border border-neutral-200 pl-9 pr-3 py-2 focus:outline-hidden focus:ring-2 focus:ring-amber-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"text-[10px] font-extrabold uppercase text-neutral-600 block\">Special Instructions / Requests</label>\n                <textarea\n                  placeholder=\"e.g. Highly prefer mild spice level for elderly grandparents. Ensure Dal Makhani has slow-simmered taste!\"\n                  value={config.specialNotes}\n                  onChange={(e) => handleConfigChange(\'specialNotes\', e.target.value)}\n                  rows={2}\n                  className=\"w-full text-xs rounded-xl border border-neutral-200 p-2.5 focus:outline-hidden focus:ring-2 focus:ring-amber-500\"\n                />\n              </div>\n\n              {/* Action buttons */}\n              <div className=\"flex gap-3 pt-3\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsSubmitModalOpen(false)}\n                  className=\"flex-1 text-center py-2 text-xs font-semibold text-neutral-600 hover:text-neutral-900 border border-neutral-200 rounded-xl transition-all cursor-pointer bg-neutral-50 hover:bg-neutral-100\"\n                >\n                  Go Back & Adjust\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"flex-1 text-center py-2 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-md cursor-pointer transition-all active:scale-[0.98]\"\n                >\n                  Generate Invoice Receipt\n                </button>\n              </div>\n\n            </form>\n          </motion.div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
    }

#!/bin/bash

clear

figlet -f big "NULL   POINTER"

echo "🚀 Welcome back, Roshan!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

printf "🖥  Hostname        : %s\n" "$(hostname)"
printf "💻 OS              : %s\n" "$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
printf "⚡ CPU             : %s\n" "$(lscpu | awk -F: '/Model name/{gsub(/^[ \t]+/,"",$2); print $2; exit}')"
printf "🧠 Memory          : %s / %s\n" \
"$(free -h | awk '/Mem:/ {print $3}')" \
"$(free -h | awk '/Mem:/ {print $2}')"

printf "💾 Root Disk       : %s / %s (%s)\n" \
"$(df -h / | awk 'NR==2 {print $3}')" \
"$(df -h / | awk 'NR==2 {print $2}')" \
"$(df -h / | awk 'NR==2 {print $5}')"

printf "⏱  Uptime          : %s\n" "$(uptime -p)"
printf "🐳 Docker          : %s running containers\n" "$(docker ps -q | wc -l)"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Happy debugging!"
echo